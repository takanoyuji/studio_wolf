---
import BaseLayout from '../layouts/BaseLayout.astro'
import site from '../data/site.json'

const title = '特定商取引法に基づく表記｜スタジオ狼（STUDIO WOLF）'
const description =
  'スタジオ狼（STUDIO WOLF）の特定商取引法に基づく表記。販売事業者・所在地・お支払い方法・キャンセルについて記載しています。'

const items = [
  { term: '販売事業者', desc: '合同会社データロー' },
  { term: '所在地', desc: '東京都新宿区西新宿7-5-9 ファーストリアルタワー新宿2901' },
  { term: '販売責任者', desc: '代表社員 高野悠司' },
  { term: '販売価格', desc: '当ウェブサイトの料金ページ（/price）に記載（税込）' },
  { term: 'お支払い方法', desc: '現金・PayPay・クレジットカード（当サイトのWeb予約はクレジットカード・Apple Pay・Google Pay。スペースマーケット・インスタベースからのご予約は各サイトの決済方法）' },
  { term: 'お支払い時期', desc: 'ご利用時。無人でのご利用は事前決済のみ（公式LINEからのご予約はクレジットカード決済リンクでご利用前にお支払い。当サイトのWeb予約はご予約時にお支払い）' },
  { term: 'キャンセル', desc: '公式LINE・当サイトからのご予約：ご利用日の2日前まで無料／前日 ご利用料金の50％／当日 ご利用料金の100％。スペースマーケット・インスタベースからのご予約は各サイトのキャンセル規定に従います。日時の変更は、空きがあれば前日・当日でも無料です。' },
]
---

<BaseLayout title={title} description={description} path="/tokusho">
  <main class="tokusho-page">
    <h1>特定商取引法に基づく表記</h1>
    <dl class="inner-page">
      {
        items.map((item) => (
          <div class="item">
            <dt>{item.term}</dt>
            <dd>{item.desc}</dd>
          </div>
        ))
      }
      <div class="item">
        <dt>お問い合わせ</dt>
        <dd>
          <a href={site.links.line} target="_blank" rel="noopener noreferrer">公式LINE</a>・
          <a href="mailto:takano@dataraw.jp">takano@dataraw.jp</a>
        </dd>
      </div>
    </dl>
    <p class="back"><a href="/">トップページへ戻る</a></p>
  </main>
</BaseLayout>

<style>
  .tokusho-page {
    margin: calc(var(--header-h) + 2rem) auto 2rem;
    padding: 1.5rem;
    max-width: 720px;
    line-height: 1.6;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 1rem;
  }

  .tokusho-page h1 {
    font-size: 1.2rem;
    margin-bottom: 0.5rem;
    text-align: center;
  }

  .inner-page {
    padding: 0;
    margin: 0.5rem auto;
  }

  .item {
    margin-bottom: 0.5rem;
    text-align: left;
  }

  .item dt {
    font-size: 1rem;
    font-weight: bold;
    color: var(--star-300);
  }

  .item dd {
    margin: 0 0 0.5rem;
    color: var(--fg-muted);
  }

  .back {
    text-align: center;
    margin-top: 1.5rem;
  }
</style>
