---
import BaseLayout from '../layouts/BaseLayout.astro'
import site from '../data/site.json'
import { studioJsonLd } from '../lib/jsonld'

const title = '内装・ブース｜スタジオ狼（STUDIO WOLF）大阪・日本橋の撮影スタジオ'
const description =
  'スタジオ狼の内装。韓国セルフ撮影・バレエコア・男装向け・宇宙の4ブースを、1回のご予約ですべて追加料金なしで使えます。季節限定セットと設備の一覧も掲載。'

// ブース（名前・広さ・写真）は予約アプリの管理画面で変える。nginx の SSI が /_site/booths を差し込む
// （deploy は oshiplus-pay の deploy/nginx/studio-wolf-reserve.conf）。読めないときは stub を出す
const boothsSsi =
  '<!--# block name="booths_stub" --><p class="booths-error">ブースの情報を読み込めませんでした。時間をおいて開き直してください。</p><!--# endblock -->' +
  '<!--# include virtual="/_site/booths" stub="booths_stub" -->'
---

<BaseLayout title={title} description={description} path="/interior" jsonLd={studioJsonLd}>
  <main class="page star-bg">
    <div class="section-inner">
      <p class="page-en">INTERIOR</p>
      <h1 class="section-title gradient-text">内装・ブース</h1>
      <p class="section-sub">1回のご予約で、すべてのブースを追加料金なしで使えます</p>

      <div class="booths">
        <Fragment set:html={boothsSsi} />
      </div>

      <section class="facilities glass">
        <h2 class="sub-title">設備</h2>
        <ul>
          {site.facilities.map((f) => <li>{f}</li>)}
        </ul>
      </section>

      <div class="page-actions">
        <a href={site.links.reserve} class="btn-primary">
          <i class="fa-regular fa-calendar-check" aria-hidden="true"></i> Web予約（空き確認・お支払い）
        </a>
        <a href={site.links.line} class="btn-line" target="_blank" rel="noopener noreferrer">
          <i class="fa-brands fa-line" aria-hidden="true"></i> 公式LINEで予約・相談
        </a>
        <a href="/" class="btn-secondary">トップへ戻る</a>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .page {
    padding: calc(var(--header-h) + 40px) 16px 72px;
    min-height: 60vh;
  }

  .page-en {
    text-align: center;
    font-size: 0.75rem;
    letter-spacing: 0.3em;
    color: var(--star-300);
  }

  .booths {
    display: grid;
    gap: 20px;
  }

  @media (min-width: 768px) {
    .booths {
      grid-template-columns: 1fr 1fr;
    }
  }

  .sub-title {
    text-align: center;
    font-size: 1.4rem;
    margin: 48px 0 8px;
  }

  .facilities {
    margin-top: 48px;
    padding: 8px 20px 24px;
  }

  .facilities .sub-title {
    margin-top: 16px;
    margin-bottom: 16px;
  }

  .facilities ul {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 8px 16px;
  }

  .facilities li::before {
    content: '✦ ';
    color: var(--neon-purple);
  }

  @media (min-width: 768px) {
    .facilities ul {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .page-actions {
    max-width: 560px;
    margin: 40px auto 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
</style>

<!-- ブースの HTML は SSI で差し込むので、Astro のスコープが付かない。.booths の下だけに効かせる -->
<style is:global>
  .booths .booth {
    overflow: hidden;
  }

  /* 写真は横にスワイプして見る */
  .booths .booth-photos {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    aspect-ratio: 4 / 3;
  }

  .booths .booth-photos img,
  .booths .booth-placeholder {
    flex: 0 0 100%;
    width: 100%;
    height: 100%;
    object-fit: cover;
    scroll-snap-align: start;
  }

  .booths .booth-body {
    padding: 16px 20px 20px;
  }

  .booths .booth-en {
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    color: var(--star-300);
  }

  .booths .booth h2,
  .booths .booth h3 {
    font-size: 1.3rem;
    margin-bottom: 8px;
  }

  .booths .booth dl {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  .booths .booth dt {
    font-size: 0.75rem;
    color: var(--fg-faint);
  }

  .booths .booth dd {
    font-weight: 700;
  }

  .booths .booths-error {
    color: var(--fg-muted);
    font-size: 0.9rem;
    text-align: center;
  }
</style>
