---
import BaseLayout from '../layouts/BaseLayout.astro'
import site from '../data/site.json'
import { studioJsonLd } from '../lib/jsonld'

const title = 'スタジオ狼（STUDIO WOLF）｜24時間商用利用OKの撮影スタジオ 大阪・日本橋'

// 星狼のキャスト一覧と同じ見せ方（縦長カード＋下に名前）。押すと詳細ページへ
const menu = [
  { href: '/price', title: '価格表', en: 'PRICE', sub: 'シェア 1名1時間 1,000円〜', img: '', icon: 'fa-solid fa-yen-sign' },
  { href: '/interior', title: '内装', en: 'INTERIOR', sub: '4つのブースと設備', img: '/intro-img1.jpg', icon: '' },
  { href: '/costume', title: 'レンタル衣装', en: 'COSTUME', sub: '1名2着まで無料', img: '', icon: 'fa-solid fa-shirt' },
]

const features = [
  { head: '24時間', body: '貸切もシェアも、深夜・早朝まで予約できます' },
  { head: '商用利用OK', body: '全プラン追加料金なし（クレジット表記をお願いします）' },
  { head: '4ブース', body: '1回の予約で4つのブースをすべて使えます' },
  { head: '衣装2着無料', body: 'レンタル衣装は1名2着まで無料です' },
]

const gallery = [
  { img: '/intro-img1.jpg', alt: '黄色と緑の椅子を置いたブース' },
  { img: '/intro-img5.jpg', alt: 'パステルカラーの椅子と壁のブース' },
  { img: '/intro-img8.jpg', alt: 'ネオンの十字架とカーテンのブース' },
  { img: '/intro-img2.jpg', alt: 'カラフルなリボンを垂らした壁面' },
  { img: '/intro-img6.jpg', alt: '配信用のデスクとモニター' },
  { img: '/intro-img4.jpg', alt: '深緑の壁と棚のブース' },
]

const calendarSrc = site.calendarId
  ? `https://calendar.google.com/calendar/embed?src=${encodeURIComponent(site.calendarId)}&ctz=Asia%2FTokyo&mode=WEEK&showTitle=0&showPrint=0&showCalendars=0&showTz=0&hl=ja`
  : ''
---

<BaseLayout title={title} description={site.description} path="/" jsonLd={studioJsonLd}>
  <main>
    <!-- HERO -->
    <section class="hero star-bg">
      <div class="stars" aria-hidden="true"></div>
      <div class="hero-inner">
        <img src="/logo.png" alt="スタジオ狼（STUDIO WOLF）ロゴ" class="hero-logo" width="260" height="197" fetchpriority="high" />
        <p class="hero-eyebrow">OSAKA NIPPONBASHI PHOTO STUDIO</p>
        <h1>
          <span class="hero-name gradient-text text-neon-glow">スタジオ狼</span>
          <span class="hero-catch">{site.catch}</span>
        </h1>
        <p class="hero-lead">大阪・日本橋の撮影スタジオ。<br />近鉄日本橋駅から徒歩6分。</p>
        <div class="hero-actions">
          <a href={site.links.line} class="btn-line hero-line" target="_blank" rel="noopener noreferrer">
            <i class="fa-brands fa-line" aria-hidden="true"></i> 予約はこちら（公式LINE）
          </a>
          <div class="hero-sub-actions">
            <a href="#menu" class="btn-primary">MENU を見る</a>
            <a href="#calendar" class="btn-secondary">予約状況</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 特徴 -->
    <section class="features" aria-label="スタジオの特徴">
      <ul class="feature-list">
        {
          features.map((f) => (
            <li class="glass">
              <strong class="gradient-text">{f.head}</strong>
              <span>{f.body}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- MENU -->
    <section class="section star-bg" id="menu">
      <div class="section-inner">
        <h2 class="section-title gradient-text">MENU</h2>
        <p class="section-sub">料金・内装・衣装の詳しい内容はこちら</p>
        <ul class="menu-grid">
          {
            menu.map((m) => (
              <li>
                <a href={m.href} class="menu-card glass">
                  <div class="menu-thumb">
                    {m.img ? (
                      <img src={m.img} alt="" width="600" height="800" loading="lazy" />
                    ) : (
                      <div class="placeholder menu-icon">
                        <i class={m.icon} aria-hidden="true" />
                      </div>
                    )}
                    <div class="menu-shade" />
                    <div class="menu-label">
                      <span class="menu-en">{m.en}</span>
                      <span class="menu-title">{m.title}</span>
                      <span class="menu-sub">{m.sub}</span>
                    </div>
                  </div>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- RESERVE -->
    <section class="section" id="reserve">
      <div class="section-inner">
        <h2 class="section-title gradient-text">RESERVE</h2>
        <p class="section-sub">ご予約の窓口</p>

        <div class="reserve-main glass">
          <p class="reserve-badge">おすすめ</p>
          <h3>公式LINE</h3>
          <p>友だち追加してメッセージを送るだけ。スタッフ対応（有人）・無人のどちらのご利用も受け付けます。衣装レンタルや深夜の有人対応のご相談もこちらから。</p>
          <a href={site.links.line} class="btn-line" target="_blank" rel="noopener noreferrer">
            <i class="fa-brands fa-line" aria-hidden="true"></i> 予約はこちら
          </a>
        </div>

        <div class="reserve-sites">
          <a href={site.links.spacemarket} class="reserve-site glass" target="_blank" rel="noopener noreferrer">
            <strong>スペースマーケット</strong>
            <span>原則無人でのご利用です</span>
          </a>
          <a href={site.links.instabase} class="reserve-site glass" target="_blank" rel="noopener noreferrer">
            <strong>インスタベース</strong>
            <span>原則無人でのご利用です</span>
          </a>
        </div>
        <p class="reserve-note">スタッフの対応時間は日によって異なります。有人でのご利用をご希望の方は、事前に公式LINEでご確認ください。<br />スペースマーケット・インスタベースからのご予約は、各サイトに掲載されている料金・利用条件が適用されます。</p>
      </div>
    </section>

    <!-- 予約状況 -->
    <section class="section star-bg" id="calendar">
      <div class="section-inner">
        <h2 class="section-title gradient-text">CALENDAR</h2>
        <p class="section-sub">予約状況（空いている時間・予約済みの時間）</p>
        {
          calendarSrc ? (
            <div class="calendar-frame calendar-live">
              <iframe src={calendarSrc} title="スタジオ狼の予約状況カレンダー" loading="lazy" />
            </div>
          ) : (
            <div class="calendar-frame placeholder calendar-placeholder">予約状況カレンダーは準備中です</div>
          )
        }
        <p class="calendar-notice">{site.calendarNotice}</p>
      </div>
    </section>

    <!-- ABOUT -->
    <section class="section" id="about">
      <div class="section-inner about">
        <h2 class="section-title gradient-text">ABOUT</h2>
        <p>
          男装コンカフェ「星狼」の運営チームがつくった撮影スタジオです。コスプレ・宣材・SNS用の写真や動画を、24時間いつでも撮れます。
        </p>
        <p>
          韓国セルフ撮影・バレエコア・男装向け・宇宙の4つのブースを、1回のご予約ですべてお使いいただけます。撮った写真や動画は、全プラン追加料金なしで商用利用できます。
        </p>
        <ul class="gallery">
          {
            gallery.map((g) => (
              <li>
                <img src={g.img} alt={g.alt} width="600" height="600" loading="lazy" />
              </li>
            ))
          }
        </ul>
        <p class="back-link"><a href="/guide" class="btn-secondary">ご利用案内・ルールを見る</a></p>
      </div>
    </section>

    <!-- ACCESS -->
    <section class="section star-bg" id="access">
      <div class="section-inner">
        <h2 class="section-title gradient-text">ACCESS</h2>
        <div class="access">
          <iframe
            src={site.links.mapEmbed}
            title="スタジオ狼（STUDIO WOLF）の地図"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"></iframe>
          <div class="access-text">
            <p>{site.address.full}</p>
            <ul>
              {site.access.map((a) => <li>{a}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  /* HERO */
  .hero {
    position: relative;
    min-height: min(100svh, 820px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: calc(var(--header-h) + 32px) 16px 48px;
    overflow: hidden;
    background: radial-gradient(ellipse at 50% 0%, var(--night-700) 0%, var(--night-900) 40%, var(--night-950) 100%);
  }

  .stars {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      radial-gradient(1.5px 1.5px at 10% 20%, rgba(255, 255, 255, 0.8), transparent),
      radial-gradient(1px 1px at 25% 70%, rgba(255, 255, 255, 0.6), transparent),
      radial-gradient(2px 2px at 40% 35%, rgba(255, 255, 255, 0.5), transparent),
      radial-gradient(1px 1px at 55% 85%, rgba(255, 255, 255, 0.7), transparent),
      radial-gradient(1.5px 1.5px at 70% 15%, rgba(255, 255, 255, 0.6), transparent),
      radial-gradient(1px 1px at 85% 55%, rgba(255, 255, 255, 0.8), transparent),
      radial-gradient(2px 2px at 92% 80%, rgba(255, 255, 255, 0.4), transparent),
      radial-gradient(1px 1px at 5% 90%, rgba(255, 255, 255, 0.6), transparent);
    animation: twinkle 4s ease-in-out infinite alternate;
  }

  @keyframes twinkle {
    from { opacity: 0.5; }
    to { opacity: 1; }
  }

  .hero-inner {
    position: relative;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    max-width: 560px;
    width: 100%;
  }

  .hero-logo {
    width: min(260px, 70vw);
    height: auto;
    filter: drop-shadow(0 0 24px rgba(192, 38, 211, 0.55));
  }

  .hero-eyebrow {
    color: var(--fg-faint);
    font-size: 0.75rem;
    letter-spacing: 0.3em;
  }

  .hero h1 {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .hero-name {
    font-size: clamp(2.6rem, 11vw, 4rem);
    font-weight: 900;
    line-height: 1.2;
  }

  .hero-catch {
    font-size: clamp(1.1rem, 4.5vw, 1.5rem);
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .hero-lead {
    color: var(--fg-muted);
  }

  .hero-actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
    max-width: 400px;
    margin-top: 8px;
  }

  .hero-line {
    font-size: 1.05rem;
    min-height: 56px;
  }

  .hero-sub-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .hero-sub-actions a {
    padding-left: 0.5rem;
    padding-right: 0.5rem;
  }

  /* 特徴 */
  .features {
    padding: 0 16px 24px;
    background: var(--night-950);
  }

  .feature-list {
    list-style: none;
    max-width: 960px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  .feature-list li {
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .feature-list strong {
    font-size: 1.15rem;
    font-weight: 900;
  }

  .feature-list span {
    font-size: 0.82rem;
    color: var(--fg-muted);
    line-height: 1.6;
  }

  @media (min-width: 768px) {
    .feature-list {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* MENU（星狼のキャストカードと同じ形） */
  .menu-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    max-width: 760px;
    margin: 0 auto;
  }

  .menu-card {
    display: block;
    overflow: hidden;
    text-decoration: none;
    transition: transform 0.3s, border-color 0.3s;
  }

  .menu-card:hover {
    transform: scale(1.03);
    border-color: var(--neon-violet);
  }

  .menu-thumb {
    position: relative;
    aspect-ratio: 3 / 4;
    background: var(--night-900);
  }

  .menu-thumb img,
  .menu-icon {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s;
  }

  .menu-card:hover .menu-thumb img {
    transform: scale(1.06);
  }

  .menu-icon i {
    font-size: clamp(2.2rem, 10vw, 4rem);
    color: rgba(240, 234, 250, 0.35);
    margin-bottom: 30%;
  }

  .menu-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(6, 4, 15, 0.9), transparent 60%);
  }

  .menu-label {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 10px;
    display: flex;
    flex-direction: column;
    line-height: 1.35;
  }

  .menu-en {
    font-size: 0.62rem;
    letter-spacing: 0.15em;
    color: var(--star-300);
  }

  .menu-title {
    font-weight: 900;
    font-size: clamp(0.9rem, 3.6vw, 1.15rem);
  }

  .menu-card:hover .menu-title {
    color: var(--neon-purple);
  }

  .menu-sub {
    font-size: clamp(0.62rem, 2.6vw, 0.78rem);
    color: var(--fg-muted);
    margin-top: 2px;
  }

  /* RESERVE */
  .reserve-main {
    max-width: 560px;
    margin: 0 auto;
    padding: 28px 20px;
    text-align: center;
    border-color: rgba(6, 199, 85, 0.5);
    position: relative;
  }

  .reserve-badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--line-green);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 2px 14px;
    border-radius: 9999px;
  }

  .reserve-main h3 {
    font-size: 1.4rem;
    margin-bottom: 8px;
  }

  .reserve-main p {
    color: var(--fg-muted);
    font-size: 0.9rem;
    margin-bottom: 20px;
    text-align: left;
  }

  .reserve-main .btn-line {
    width: 100%;
    font-size: 1.05rem;
  }

  .reserve-sites {
    max-width: 560px;
    margin: 16px auto 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .reserve-site {
    padding: 14px 10px;
    text-align: center;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 2px;
    transition: border-color 0.2s;
  }

  .reserve-site:hover {
    border-color: var(--neon-violet);
  }

  .reserve-site strong {
    font-size: 0.92rem;
  }

  .reserve-site span {
    font-size: 0.72rem;
    color: var(--fg-faint);
  }

  .reserve-note {
    max-width: 560px;
    margin: 16px auto 0;
    font-size: 0.82rem;
    color: var(--fg-muted);
  }

  /* 予約状況 */
  .calendar-frame {
    border-radius: 1rem;
    overflow: hidden;
  }

  .calendar-live {
    background: #fff;
    height: 620px;
  }

  .calendar-frame iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .calendar-placeholder {
    height: 240px;
  }

  .calendar-notice {
    margin-top: 12px;
    font-size: 0.82rem;
    color: var(--fg-muted);
  }

  /* ABOUT */
  .about > p {
    max-width: 640px;
    margin: 0 auto 16px;
    color: var(--fg-muted);
  }

  .gallery {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
    margin-top: 32px;
  }

  .gallery img {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 8px;
  }

  /* ACCESS */
  .access {
    display: grid;
    gap: 20px;
  }

  .access iframe {
    width: 100%;
    height: 320px;
    border: 0;
    border-radius: 1rem;
  }

  .access-text ul {
    list-style: none;
    color: var(--fg-muted);
    margin-top: 8px;
  }

  @media (min-width: 768px) {
    .access {
      grid-template-columns: 3fr 2fr;
      align-items: center;
    }
  }
</style>
