---
import BaseLayout from '../layouts/BaseLayout.astro'
import site from '../data/site.json'
import pricing from '../data/pricing.json'

const title = 'スタジオ狼（STUDIO WOLF）｜大阪・日本橋 コスプレ撮影スタジオ'

// ヒーロー兼スライドショー。色は各スライドのテーマカラー（背景・ヘッダー下線に反映）
const slides = [
  { img: '/intro-img3.jpg', color: '#FF9900', alt: '白ホリゾントでのコスプレ撮影作例' },
  { img: '/intro-img2.jpg', color: '#0033FF', alt: 'ポップな小物を使ったコスプレ撮影作例' },
  { img: '/intro-img4.jpg', color: '#FF3399', alt: 'スタジオ狼のスタジオ内観' },
  { img: '/intro-img5.jpg', color: '#0033FF', alt: '衣装を着たキャストの宣材撮影作例' },
  { img: '/intro-img6.jpg', color: '#FF9900', alt: 'ライティングを効かせた撮影作例' },
  { img: '/intro-img7.jpg', color: '#FF3399', alt: '非日常のシーンを再現した撮影作例' },
  { img: '/intro-img8.jpg', color: '#0033FF', alt: 'コンカフェ向け宣材写真の撮影作例' },
  { img: '/intro-img9.jpg', color: '#FF9900', alt: 'ライブ配信にも使えるスタジオの様子' },
]

const gallery = [
  { img: '/intro-img1.jpg', alt: 'スタジオ狼の白ホリゾント撮影スペース' },
  { img: '/intro-img2.jpg', alt: 'ポップな小物を使ったコスプレ撮影作例' },
  { img: '/intro-img3.jpg', alt: '白ホリゾントでのコスプレ撮影作例' },
  { img: '/intro-img4.jpg', alt: 'スタジオ狼のスタジオ内観' },
  { img: '/intro-img5.jpg', alt: '衣装を着たキャストの宣材撮影作例' },
  { img: '/intro-img6.jpg', alt: 'ライティングを効かせた撮影作例' },
  { img: '/intro-img7.jpg', alt: '非日常のシーンを再現した撮影作例' },
  { img: '/intro-img8.jpg', alt: 'コンカフェ向け宣材写真の撮影作例' },
  { img: '/intro-img9.jpg', alt: 'ライブ配信にも使えるスタジオの様子' },
]

// 料金データから構造化データ用のオファー一覧を組み立てる（数値化できる行のみ）
const offers = pricing.groups.flatMap((group) =>
  group.rows.flatMap((row) => {
    const priceIndex = group.columns.length - row.values.length
    return row.values
      .map((value, i) => {
        const amount = value.replace(/,/g, '').match(/^(\d+)円/)
        if (!amount) return null
        const column = group.columns[priceIndex + i]
        return {
          '@type': 'Offer',
          name: `${group.title}｜${row.label}${column && column !== '料金' ? `（${column}）` : ''}`,
          price: Number(amount[1]),
          priceCurrency: 'JPY',
        }
      })
      .filter(Boolean)
  })
)

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'PhotographyBusiness',
  '@id': `${site.url}/#studio`,
  name: site.name,
  alternateName: [site.nameShort, site.nameEn],
  description: site.description,
  url: site.url,
  image: [new URL(site.ogImage, site.url).href],
  address: {
    '@type': 'PostalAddress',
    addressCountry: 'JP',
    postalCode: site.address.postalCode,
    addressRegion: site.address.region,
    addressLocality: site.address.locality,
    streetAddress: site.address.street,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: site.geo.lat,
    longitude: site.geo.lng,
  },
  // 12:00〜翌1:00（ソロプランの最長25時）。schema.org は 25:00 表記を許さないため日跨ぎで表現する
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
    opens: site.opens,
    closes: site.closes,
  },
  priceRange: site.priceRange,
  currenciesAccepted: 'JPY',
  paymentAccepted: 'クレジットカード, PayPay, 銀行振込',
  sameAs: [site.links.instagram, site.links.x, site.links.instabase],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: '料金プラン',
    itemListElement: offers,
  },
}
---

<BaseLayout title={title} description={site.description} path="/" jsonLd={jsonLd}>
  <!-- スマホ用ヘッダー -->
  <header class="top-bar-sp" id="header">
    <button class="menu-button" type="button" aria-label="メニューを開く" aria-expanded="false">
      <i class="fa-solid fa-bars"></i>
    </button>
    <nav class="navmenu" hidden aria-label="メインメニュー">
      <ul>
        <li><a href="#about">ABOUT</a></li>
        <li><a href="#price">PRICE</a></li>
        <li><a href="#reserve">RESERVE</a></li>
        <li><a href="#access">ACCESS</a></li>
      </ul>
    </nav>
  </header>

  <!-- ヘッダー -->
  <nav class="top-bar" aria-label="メインメニュー">
    <div class="bar-flex">
      <div class="bar-contents">
        <a href="#about"><span>ABOUT</span><p>お店について</p></a>
      </div>
      <div class="bar-contents">
        <a href="#price"><span>PRICE</span><p>料金プラン</p></a>
      </div>
      <div class="bar-contents">
        <a href="#reserve"><span>RESERVE</span><p>LINE予約</p></a>
      </div>
      <div class="bar-contents">
        <a href="#access"><span>ACCESS</span><p>アクセス</p></a>
      </div>
    </div>
  </nav>

  <!-- スライドショー -->
  <section class="slideshow-wrapper" style={`background-color: ${slides[0].color}`}>
    <div class="slide-content">
      {
        slides.map((slide, index) => (
          <img
            class="hero-img"
            src={slide.img}
            alt={slide.alt}
            width="1200"
            height="800"
            hidden={index !== 0}
            loading={index === 0 ? 'eager' : 'lazy'}
            data-color={slide.color}
          />
        ))
      }
      <h1 class="hero-title">
        <span class="hero-brand">スタジオ狼（STUDIO WOLF）</span>
        <span class="hero-catch">
          頑張るあなたのためのスタジオ<br />SNS・コンカフェ・配信・TikTok撮影<br
          />あなたの世界を形にします
        </span>
      </h1>
    </div>
    <p class="hero-lead">
      大阪・日本橋のコスプレ撮影スタジオ。白ホリゾント・更衣室完備で、近鉄日本橋駅から徒歩6分。
    </p>
  </section>

  <main>
    <!-- ABOUT -->
    <section class="box box-a" id="about">
      <h2>ABOUT</h2>
      <p>
        コスプレイヤー専門コンカフェ「星狼」の運営チームが手がける、コスプレイヤーによる、コスプレイヤーのための撮影スタジオが誕生！<br
        />実際にコスプレを愛するスタッフが「本当に欲しかった」空間を形にしました。<br
        />背景・小道具・ライティングまで、すべてが“映える”仕様。<br
        />ポップで可愛い世界観から、非日常なシーンまで、あなたの「なりたい」が叶う場所です。<br
        />撮影初心者から上級者まで大歓迎。<br />あなたの表現がもっと自由になる、新しいスタジオ体験を。
      </p>

      <h3 class="sub-heading">設備・特徴</h3>
      <ul class="facility-list">
        {
          site.facilities.map((facility) => (
            <li>
              <strong>{facility.name}</strong>
              <span>{facility.note}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- PRICE -->
    <section class="box box-b" id="price">
      <h2>PRICE</h2>
      <div class="price-body">
        {
          pricing.groups.map((group) => (
            <div class="price-table">
              <h3>{group.title}</h3>
              {group.lead && <p class="price-lead">{group.lead}</p>}
              <div class="table-wrapper">
                <table>
                  <thead>
                    <tr>
                      {group.columns.map((column) => (
                        <th scope="col">{column}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {group.rows.map((row) => {
                      // 値の列が行見出しの右から始まるため、対応する列名をずらして取得する
                      const valueColumnOffset = group.columns.length - row.values.length
                      return (
                        <tr>
                          <th scope="row">{row.label}</th>
                          {row.values.map((value, i) => (
                            <td data-label={group.columns[valueColumnOffset + i]}>{value}</td>
                          ))}
                        </tr>
                      )
                    })}
                  </tbody>
                </table>
              </div>
              {group.notes.length > 0 && (
                <ul class="note">
                  {group.notes.map((note) => (
                    <li>{note}</li>
                  ))}
                </ul>
              )}
            </div>
          ))
        }
        <p class="price-footnote">{pricing.taxNote}</p>
        <p class="price-footnote">{pricing.eventNote}</p>
      </div>
    </section>

    <!-- RESERVE -->
    <section class="box box-c" id="reserve">
      <h2>RESERVE</h2>
      <div class="reverve-flex">
        <div class="line-link">
          <a
            href={site.links.line}
            class="line-button"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LINEで予約する"
          >
            <img
              src="https://upload.wikimedia.org/wikipedia/commons/4/41/LINE_logo.svg"
              alt="LINEで予約"
              class="line-icon"
              width="150"
              height="150"
              loading="lazy"
            />
          </a>
        </div>
        <div class="reserve-contents">
          <p>簡単1STEP！<br />公式LINEを追加して簡単予約！</p>
          <p class="reserve-sub">
            予約サイトからのご予約はこちら
            <a href={site.links.instabase} target="_blank" rel="noopener noreferrer">
              インスタベース
            </a>
          </p>
        </div>
      </div>
    </section>

    <!-- ACCESS -->
    <section class="box box-d" id="access">
      <h2>ACCESS</h2>
      <iframe
        src={site.links.mapEmbed}
        title="スタジオ狼（STUDIO WOLF）の地図"
        style="border: 0"
        allowfullscreen
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"></iframe>
      <p>
        {site.address.full}<br />
        {site.access.join('・')}
      </p>
    </section>

    <!-- ギャラリー -->
    <section class="gallery" id="gallery">
      <h2 class="visually-hidden">撮影作例ギャラリー</h2>
      <div class="grid">
        {
          gallery.map((image) => (
            <img
              class="grid-img"
              src={image.img}
              alt={image.alt}
              width="600"
              height="600"
              loading="lazy"
            />
          ))
        }
      </div>
    </section>
  </main>

  <!-- フッター -->
  <footer>
    <div class="footer-flex">
      <a href="#header">
        <img src="/logo.png" alt="スタジオ狼（STUDIO WOLF）ロゴ" class="logo" width="150" height="150" loading="lazy" />
      </a>
      <section class="sns-icons" aria-label="SNS・予約リンク">
        <a href={site.links.line} aria-label="LINE" target="_blank" rel="noopener noreferrer">
          <i class="fa-brands fa-line"></i>
        </a>
        <a
          href={site.links.instagram}
          aria-label="Instagram"
          target="_blank"
          rel="noopener noreferrer"
        >
          <i class="fa-brands fa-instagram"></i>
        </a>
        <a href={site.links.x} aria-label="X" target="_blank" rel="noopener noreferrer">
          <i class="fa-brands fa-x-twitter"></i>
        </a>
      </section>
    </div>
    <a href="/tokusho" class="tokusho-link">特定商取引法に基づく表記</a>
    <small>© 2025 スタジオ狼（STUDIO WOLF）</small>
  </footer>
</BaseLayout>

<script>
  // スマホ用メニュー
  const menuButton = document.querySelector<HTMLButtonElement>('.menu-button')
  const navmenu = document.querySelector<HTMLElement>('.navmenu')

  const setMenu = (open: boolean) => {
    if (!menuButton || !navmenu) return
    navmenu.hidden = !open
    menuButton.setAttribute('aria-expanded', String(open))
    menuButton.setAttribute('aria-label', open ? 'メニューを閉じる' : 'メニューを開く')
    const icon = menuButton.querySelector('i')
    if (icon) icon.className = open ? 'fa-solid fa-xmark' : 'fa-solid fa-bars'
  }

  menuButton?.addEventListener('click', () => setMenu(navmenu?.hidden ?? true))
  navmenu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenu(false)))

  // ヒーローのスライドショー（3秒ごと）
  const wrapper = document.querySelector<HTMLElement>('.slideshow-wrapper')
  const heroImages = Array.from(document.querySelectorAll<HTMLImageElement>('.hero-img'))

  const topBar = document.querySelector<HTMLElement>('.top-bar')

  if (wrapper && heroImages.length > 1) {
    let index = 0
    setInterval(() => {
      heroImages[index].hidden = true
      index = (index + 1) % heroImages.length
      heroImages[index].hidden = false
      const color = heroImages[index].dataset.color ?? ''
      wrapper.style.backgroundColor = color
      // ヘッダー下線もスライドのテーマカラーに追従させる（旧SPAと同じ挙動）
      if (topBar) topBar.style.borderBottomColor = color
    }, 3000)
  }
</script>

<style>
  /* スマホ用ヘッダー */
  .top-bar-sp {
    text-align: right;
    position: relative;
    z-index: 1;
    height: 10%;
  }

  .menu-button {
    position: relative;
    font-size: 2rem;
    background: none;
    border: none;
    z-index: 2;
    min-width: 48px;
    min-height: 48px;
  }

  .navmenu {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    text-align: center;
    background: rgba(255, 255, 255, 0.8);
    height: 20vh;
    transition: all 0.6s ease;
  }

  .navmenu > ul {
    list-style: none;
    margin: 30px;
  }

  .navmenu > ul > li > a {
    display: block;
    text-decoration: none;
    color: black;
    margin: 16px;
  }

  /* ヘッダー */
  .top-bar {
    display: none;
  }

  .bar-flex {
    display: flex;
    justify-content: flex-end;
    padding: 16px;
  }

  .bar-contents {
    text-align: center;
    width: 130px;
    min-width: 48px;
    min-height: 48px;
    align-items: center;
    justify-content: center;
  }

  .bar-contents > a {
    text-decoration: none;
    margin: 0;
    padding: 0;
    color: black;
  }

  .bar-contents > a > span {
    margin: 0;
    font-weight: bold;
  }

  .bar-contents > a > p {
    margin: 10px auto;
    font-size: 16px;
    font-weight: bold;
  }

  /* スライドショー */
  .slideshow-wrapper {
    transition: background-color 0.5s ease;
    margin-top: 10px;
    padding: 8px;
    color: #333;
  }

  .slide-content {
    position: relative;
  }

  .hero-img {
    height: 40vh;
    width: 100%;
    object-fit: cover;
    display: block;
  }

  .hero-img[hidden] {
    display: none;
  }

  .hero-title {
    margin: 0;
    padding: 0;
    color: white;
    opacity: 0.8;
    font-weight: bold;
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-family: 'Hiragino Sans W7', 'Noto Sans JP', sans-serif;
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.4);
    line-height: 1.2;
    max-width: 90%;
    margin: 0 auto;
    word-break: keep-all;
    overflow-wrap: break-word;
  }

  .hero-brand {
    font-size: 16px;
    letter-spacing: 0.05em;
    margin-bottom: 12px;
  }

  .hero-catch {
    font-size: 24px;
  }

  .hero-lead {
    margin: 12px auto 0;
    padding: 0 8px 8px;
    color: white;
    font-size: 14px;
    line-height: 1.6;
    text-align: center;
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.3);
  }

  /* 共通ブロック */
  .box {
    margin: 24px 0;
    padding: 16px;
    font-size: 20px;
    width: 92%;
  }

  .box > h2 {
    font-size: 40px;
    margin: 0;
    padding: 0;
    color: white;
    font-family: Impact, 'Noto Sans JP', sans-serif;
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.4);
  }

  .box > p {
    font-size: 16px;
    margin: 0;
    padding: 20px;
    color: white;
    text-align: left;
    line-height: 1.5;
  }

  .sub-heading {
    color: white;
    font-size: 20px;
    text-align: left;
    padding: 0 20px;
  }

  /* ABOUT */
  .box-a {
    background: #0033ff;
    text-align: center;
    margin-right: auto;
  }

  .box-a > h2,
  .box-a > .sub-heading {
    text-align: left;
  }

  .facility-list {
    list-style: none;
    display: grid;
    gap: 8px;
    padding: 16px 20px 4px;
    text-align: left;
  }

  .facility-list > li {
    background: rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    padding: 10px 14px;
    color: white;
    font-size: 14px;
    line-height: 1.5;
  }

  .facility-list strong {
    display: block;
    font-size: 16px;
  }

  /* PRICE */
  .box-b {
    background: #ff3399;
    text-align: center;
    margin-left: auto;
  }

  .box-b > h2 {
    text-align: right;
  }

  .price-body {
    display: grid;
    gap: 20px;
    margin: 20px 0;
  }

  .price-table {
    padding: 16px;
    background: #fff0f5;
    border-radius: 10px;
    color: #333;
    text-align: left;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
  }

  .price-table h3 {
    font-size: 18px;
    color: #ff3399;
    margin-bottom: 8px;
    font-family: 'Hiragino Sans W7', 'Noto Sans JP', sans-serif;
  }

  .price-lead {
    font-size: 13px;
    line-height: 1.6;
    margin-bottom: 12px;
  }

  .table-wrapper {
    width: 100%;
  }

  .price-table table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }

  /* スマホでは表を横スクロールさせず、1行=1カードの縦積みで表示する */
  .price-table thead {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .price-table tbody tr {
    display: block;
    border: 1px solid #ccc;
    border-radius: 8px;
    background: #fff;
    padding: 10px 12px;
  }

  .price-table tbody tr + tr {
    margin-top: 10px;
  }

  .price-table tbody th {
    display: block;
    text-align: left;
    font-weight: bold;
    line-height: 1.5;
    padding: 0 0 8px;
    border-bottom: 1px dashed #e3c3d3;
  }

  .price-table tbody td {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    text-align: right;
    font-weight: bold;
    padding: 8px 0 0;
    line-height: 1.5;
  }

  .price-table tbody td::before {
    content: attr(data-label);
    font-weight: normal;
    color: #d1176f;
    text-align: left;
    white-space: nowrap;
  }

  .price-table .note {
    margin-top: 12px;
    padding-left: 1.2em;
    font-size: 12px;
    line-height: 1.6;
    color: #d1176f;
  }

  .price-footnote {
    color: white;
    font-size: 13px;
    line-height: 1.6;
    text-align: left;
    padding: 0 4px;
  }

  /* RESERVE */
  .box-c {
    background: #ff9900;
    text-align: center;
    margin-right: auto;
    font-family: 'Hiragino Sans W7', 'Noto Sans JP', sans-serif;
  }

  .box-c > h2 {
    text-align: left;
  }

  .reverve-flex {
    display: flex;
    justify-content: space-around;
    align-items: center;
    padding: 16px;
  }

  .line-link {
    min-width: 48px;
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .line-icon {
    width: 100px;
    height: 100px;
    object-fit: contain;
  }

  .reserve-contents > p {
    font-size: 16px;
    margin: 0;
    padding: 20px;
    color: white;
    text-align: center;
    line-height: 1.5;
  }

  .reserve-sub {
    font-size: 13px !important;
    padding-top: 0 !important;
  }

  .reserve-sub > a {
    color: white;
  }

  /* ACCESS */
  .box-d {
    background: #00cc33;
    text-align: center;
    margin-left: auto;
  }

  .box-d > h2 {
    text-align: right;
  }

  iframe {
    margin: 30px auto;
    width: 100%;
    height: 300px;
    display: block;
  }

  /* ギャラリー */
  .grid {
    display: flex;
    flex-wrap: wrap;
    margin: 32px 0;
  }

  .grid-img {
    width: 40%;
    height: 40vw;
    object-fit: cover;
    margin: 2% 5%;
  }

  .visually-hidden {
    position: absolute;
